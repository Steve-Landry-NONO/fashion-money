DATABASE_URL=postgresql+psycopg://fashion:fashion@db:5432/fashion
ANALYTICS_SINK=stdout

TIGHT_THRESHOLD_ABS=15
TIGHT_THRESHOLD_PCT=0.15
ROLLOVER_CAP_MULTIPLIER=1.0

# Real capture storage (MinIO locally; replace for production S3-compatible storage)
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=fashion
S3_SECRET_KEY=fashionfashion
S3_REGION=us-east-1
IMAGE_BUCKET=fashion-money-captures
MAX_IMAGE_BYTES=10485760

# Real Vision (choose mock, groq, or openai)
DECOMPOSITION_PROVIDER=groq
GROQ_API_KEY=
OPENAI_API_KEY=
VISION_MODEL=qwen/qwen3.8-27b
